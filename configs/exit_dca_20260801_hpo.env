# =============================================================================
# CAU HINH HPO 2026-08-01 — mo DCA grid + exit giveback cho WFO/HPO tune
# =============================================================================
# Khac ban frozen o DUY NHAT mot cho: DCA_GRID_SCALAR=true.
# Khi =true:
#   - Configs bo qua DCA_GRID_LEVELS / DCA_GRID_WEIGHTS / DCA_TIER_MARGIN_CAPS
#     (khong con nguon su that kep) va sinh luoi tu cac SO VO HUONG duoi day.
#   - StrategyWfoTask HOAN DOI genome (khong cong don):
#       bo   DCA_LOSS_BIG_DOWN, DCA_TIME_BIG_DOWN   (gene CHET khi grid bat:
#            DcaProcessor re sang shouldDcaGrid, khong bao gio goi shouldDca)
#       them DCA_GRID_L1, DCA_GRID_STEP, DCA_GRID_LEGS, DCA_GRID_W_RATIO, DCA_GRID_SCALE
#       them DCA_TIER_CAP_BASE, DCA_TIER_CAP_STEP     (khi DCA_TIER_MARGIN_ENABLED)
#   - Bat TS_GIVEBACK_FLOOR thi genome tiep tuc hoan doi:
#       bo   TS_MAX_GAP, TS_MAX_GAP_WEAK, TS_WEAK_MOMENTUM_THRES
#            (nhanh Math.max KHONG dung maxGap => 3 gene nay la nhieu thuan)
#       them TS_MIN_GAP, TS_GIVEBACK_RATIO
#     VA mo san TS_PROFIT_MULTIPLIER xuong 1.0 (=1.0 chinh la TS_RATCHET_DECOUPLED).
#   Tong: 17 gene -> 21 gene.
#
# ⚠️ WFO_FROZEN_GENOME cu (17 so) SE FAIL fail-fast voi cau hinh nay — dung y do,
#    vector cu khong con mo ta dung khong gian tham so. Sinh vector moi tu run nay.
# -----------------------------------------------------------------------------

# --- CONG TAC scalar (bat buoc de HPO cham duoc DCA) ---
DCA_GRID_SCALAR=true

# --- DCA GRID: gia tri KHOI DIEM = sample-0 cua random search ---
# Dat trung tam vung da do duoc de sample-0 khong phai diem vo ly.
DCA_GRID_ENABLED=true
DCA_GRID_L1=-0.50
DCA_GRID_STEP=0.20
DCA_GRID_LEGS=3
DCA_GRID_W_RATIO=2.0
DCA_GRID_SCALE=8

# --- TRAN MARGIN THEO BAC ---
DCA_TIER_MARGIN_ENABLED=true
DCA_TIER_CAP_BASE=0.50
DCA_TIER_CAP_STEP=0.10
SIM_BREAKER_MODE=OFF

# --- EXIT giveback (bat nhanh moi) ---
TS_GIVEBACK_FLOOR=true
TS_MIN_GAP=0.01
TS_GIVEBACK_RATIO=0.5
RATE_PROFIT_STOP_MARKET=0.05
TS_PROFIT_MULTIPLIER=5.21847
# TS_RATCHET_DECOUPLED KHONG set: da bi nuot boi TS_PROFIT_MULTIPLIER=1.0.
# Set ca hai se dem 2 lan cung mot y dinh -> khong dat.

# Ep san/tran TS_PROFIT_MULTIPLIER neu muon khac mac dinh (mac dinh khi FLOOR=true la [1.0,8.0])
# WFO_TSMULT_LO=1.0
# WFO_TSMULT_HI=8.0

# --- SIM ---
SIM_APPLY_FUNDING=true
