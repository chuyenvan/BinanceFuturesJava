# =============================================================================
# BAN CHOT TAM 2026-08-01 — DCA grid + tran margin theo bac + exit min-rate
# Nguon: docs/reports/HANDOFF_20260801_dca_grid_exit.md (muc "BAN CHOT TAM")
# =============================================================================
# Dung file nay khi muon TAI LAP CHINH XAC so lieu da do trong phien 2026-08-01.
# DCA_GRID_SCALAR=false (khong set) => engine doc THANG mang duoi day, KHONG dung
# cong thuc scalar => byte-identical voi ban da do. Muon chay HPO thi dung file
# exit_dca_20260801_hpo.env, KHONG sua file nay.
#
# ⚠️ Trang thai: CHOT TAM, CHUA production-ready. Bon van de con treo (HANDOFF muc
#    A-D): %OOS-duong ket 37.5% (nut that o ENTRY, khong phai exit); 63.6% PnL don
#    vao 1 window w15; Spearman train-holdout 0.14 (tham so KHONG hoc duoc tu data);
#    %hold>7d 5-6% vuot rang buoc production 2%.
# -----------------------------------------------------------------------------

# --- EXIT ---
RATE_PROFIT_STOP_MARKET=0.05
TS_PROFIT_MULTIPLIER=5.21847
# TS_GIVEBACK_FLOOR khong bat o ban chot tam => van dung nhanh min(peak*ratio, maxGap)
# TS_GIVEBACK_FLOOR=false

# --- DCA GRID (dang MANG, khong scalar) ---
DCA_GRID_ENABLED=true
DCA_GRID_LEVELS=-0.50,-0.75,-0.90
DCA_GRID_WEIGHTS=1,1,3,8
DCA_GRID_SCALE=8

# --- TRAN MARGIN THEO BAC ---
DCA_TIER_MARGIN_ENABLED=true
DCA_TIER_MARGIN_CAPS=0.50,0.60,0.70,0.80
# Tran theo bac THAY THE breaker phang; de MARGIN se chan 2 lan.
SIM_BREAKER_MODE=OFF

# --- SIM ---
SIM_APPLY_FUNDING=true
